index="volexity_lantern" source="lantern:assessment" sourcetype="lantern:indicator_match" earliest=0 latest=now
| fields _raw _time _indextime
| spath
| spath path=quality_flags{} output=quality_flags
| spath path=lantern.collection.collection_id output=collection_id
| sort 0 -num(disposition_rank), -num(disposition_time), +str(event_version)
| dedup id
| eventstats dc(id) AS findings_for_hash dc(host_id) AS hosts_for_hash BY file_hash
| eval quality_attention=if(coalesce(mvcount(quality_flags),0)>0 OR NOT in(disposition_status,"UNREVIEWED","BENIGN","MALICIOUS","SUPPRESSED"),"review","none")
| sort 0 -str(quality_attention), -num(severity_id), +str(id)
| table id severity severity_id disposition_status dest host_id signature file_hash file_path collection_id findings_for_hash hosts_for_hash quality_attention quality_flags event_version
