index="volexity_lantern" source="lantern:assessment" sourcetype="lantern:indicator_match" earliest=0 latest=now
| fields _raw _time _indextime
| spath
| spath path=quality_flags{} output=quality_flags
| spath path=lantern output=lantern_evidence
| eventstats count AS delivery_copies BY id event_version
| sort 0 +str(id), -num(disposition_rank), -num(disposition_time), +str(event_version)
| dedup id event_version
| table id _time disposition_updated_at disposition_status disposition_analyst disposition_comment severity severity_id dest signature file_hash file_path quality_flags event_version delivery_copies lantern_evidence
